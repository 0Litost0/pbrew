# pbrew list --agent — 列出已安装组件（覆盖 claude / codebuddy 双 Agent）

exec pbrew config set source $MARKETPLACE

# 安装 Rule 到 claude，Skill 到 codebuddy
exec pbrew install hello_rule --agent claude --scope user --force
exec pbrew install hello_skill --agent codebuddy --scope user --force

# claude 下只有 Rule
exec pbrew list --agent claude --scope user
stdout 'hello_rule'
! stdout 'hello_skill'

# codebuddy 下只有 Skill
exec pbrew list --agent codebuddy --scope user
stdout 'hello_skill'
! stdout 'hello_rule'

# 不合法的 agent 应报错
! exec pbrew list --agent nonexistent
