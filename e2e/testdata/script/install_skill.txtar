# pbrew install — 安装 Skill 组件（覆盖 claude / codebuddy 双 Agent，验证适配）

exec pbrew config set source $MARKETPLACE

# ── 安装到 claude (user scope) ──
exec pbrew install hello_skill --agent claude --scope user --force
stdout 'installed hello_skill'

# 验证文件存在
exists $HOME/.claude/skills/hello_skill/SKILL.md
exists $HOME/.claude/skills/hello_skill/.pbrew.json

# claude 安装内容：保留 when_to_use / disallowed-tools，变量保持原样
exec cat $HOME/.claude/skills/hello_skill/SKILL.md
stdout 'when_to_use: Need to say hello'
stdout 'disallowed-tools'
stdout 'allowed-tools'
stdout 'CLAUDE_SKILL_DIR'
stdout 'CLAUDE_PROJECT_DIR'
! stdout 'CODEBUDDY_SKILL_DIR'

# 验证安装记录
exec cat $HOME/.claude/.pbrew/_config.json
stdout 'hello_skill'
stdout '"skill"'

# ── 安装到 codebuddy (user scope) ──
exec pbrew install hello_skill --agent codebuddy --scope user --force
stdout 'installed hello_skill'

# 验证文件存在
exists $HOME/.codebuddy/skills/hello_skill/SKILL.md
exists $HOME/.codebuddy/skills/hello_skill/.pbrew.json

# codebuddy 安装内容：
# - 跳过 when_to_use / disallowed-tools
# - 变量替换为 CODEBUDDY_*
exec cat $HOME/.codebuddy/skills/hello_skill/SKILL.md
! stdout 'when_to_use'
! stdout 'disallowed-tools'
# 允许的字段仍应存在
stdout 'allowed-tools'
stdout 'description: Hello skill for E2E testing'
# 变量替换
stdout 'CODEBUDDY_SKILL_DIR'
stdout 'CODEBUDDY_PROJECT_DIR'
! stdout 'CLAUDE_SKILL_DIR'
! stdout 'CLAUDE_PROJECT_DIR'

# 验证安装记录
exec cat $HOME/.codebuddy/.pbrew/_config.json
stdout 'hello_skill'
stdout '"skill"'

# ── 再次安装（覆盖）不应报错 ──
exec pbrew install hello_skill --agent codebuddy --scope user --force
stdout 'installed hello_skill'
